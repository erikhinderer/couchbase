FROM python:3.11-slim
WORKDIR /init
COPY scripts/requirements.txt .

# Trust an optional corporate/proxy root CA before installing anything from
# PyPI -- see backend/Dockerfile for why this is needed. Exported by
# scripts/setup-corporate-ca.sh into certs/ (repo root, this build's
# context); a no-op if that hasn't been run / isn't needed.
COPY certs/ /usr/local/share/ca-certificates/extra/
RUN if find /usr/local/share/ca-certificates/extra -name '*.crt' 2>/dev/null | grep -q .; then \
      apt-get update && \
      apt-get install -y --no-install-recommends ca-certificates && \
      update-ca-certificates && \
      rm -rf /var/lib/apt/lists/*; \
    fi
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

RUN pip install --no-cache-dir -r requirements.txt
COPY scripts/init_memory.py .
COPY couchbase-memory/vector_index.json /couchbase-memory/vector_index.json
CMD ["python", "init_memory.py"]
